<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Upcoming Releases</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" />
<style>
  :root {
    --bg: #fbfaf8;
    --card: #f2efe9;
    --accent: #e8927a;
    --accent-soft: #e8927a22;
    --text: #45423e;
    --text-muted: #918c84;
    --border: #e4dfd6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', 'Pretendard', sans-serif;
    padding: 20px 12px 80px;
  }
  .wrap { max-width: 480px; margin: 0 auto; }

  .widget-title-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .widget-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .gear-btn {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.15s;
  }
  .gear-btn:hover { border-color: var(--accent); color: var(--accent); }

  .settings-panel {
    display: none;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 18px;
    gap: 14px;
    flex-direction: column;
  }
  .settings-panel.open { display: flex; }
  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .setting-row label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    color: var(--text-muted);
  }
  .setting-row input[type="color"] {
    width: 40px;
    height: 32px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    cursor: pointer;
    padding: 2px;
  }
  .settings-actions {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
  .reset-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
  }
  .reset-btn:hover { border-color: var(--accent); color: var(--accent); }

  .status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    min-height: 16px;
    margin-bottom: 10px;
  }

  .release-list { display: flex; flex-direction: column; gap: 8px; }
  .release-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 14px;
  }
  .release-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 8px;
    padding: 6px 8px;
    text-align: center;
    flex-shrink: 0;
    min-width: 44px;
    line-height: 1.3;
  }
  .release-date .day { display: block; font-size: 16px; font-weight: 700; }
  .release-meta { flex: 1; min-width: 0; }
  .release-title {
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .release-artist {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .release-dday {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .empty {
    text-align: center;
    padding: 50px 20px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1.8;
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="widget-title-bar">
    <span class="widget-name">UPCOMING RELEASES</span>
    <button class="gear-btn" id="gearBtn" title="색상 설정">⚙</button>
  </div>

  <div class="settings-panel" id="settingsPanel">
    <div class="setting-row">
      <label>배경 색</label>
      <input type="color" id="bgColor">
    </div>
    <div class="setting-row">
      <label>카드 배경 색</label>
      <input type="color" id="cardColor">
    </div>
    <div class="setting-row">
      <label>포인트 색</label>
      <input type="color" id="accentColor">
    </div>
    <div class="setting-row">
      <label>글자 색</label>
      <input type="color" id="textColor">
    </div>
    <div class="settings-actions">
      <button class="reset-btn" id="resetColors">기본값으로</button>
      <button class="reset-btn" id="copyColorLink">이 설정으로 링크 복사</button>
    </div>
  </div>

  <div class="status" id="status"></div>
  <div class="release-list" id="releaseList"></div>
</div>

<script>
const DEFAULT_COLORS = {
  bg: '#fbfaf8',
  card: '#f2efe9',
  accent: '#e8927a',
  text: '#45423e',
};

const gearBtn = document.getElementById('gearBtn');
const settingsPanel = document.getElementById('settingsPanel');
const bgColorInput = document.getElementById('bgColor');
const cardColorInput = document.getElementById('cardColor');
const accentColorInput = document.getElementById('accentColor');
const textColorInput = document.getElementById('textColor');
const resetColorsBtn = document.getElementById('resetColors');

function hexToRgba(hex, alpha) {
  const clean = hex.replace('#', '');
  const bigint = parseInt(clean, 16);
  const r = (bigint >> 16) & 255;
  const g = (bigint >> 8) & 255;
  const b = bigint & 255;
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

function applyColors(colors) {
  const root = document.documentElement.style;
  root.setProperty('--bg', colors.bg);
  root.setProperty('--card', colors.card);
  root.setProperty('--accent', colors.accent);
  root.setProperty('--accent-soft', hexToRgba(colors.accent, 0.15));
  root.setProperty('--text', colors.text);
  bgColorInput.value = colors.bg;
  cardColorInput.value = colors.card;
  accentColorInput.value = colors.accent;
  textColorInput.value = colors.text;
}

function loadColors() {
  const params = new URLSearchParams(window.location.search);
  if (params.has('accent')) {
    return {
      bg: '#' + (params.get('bg') || DEFAULT_COLORS.bg.replace('#', '')),
      card: '#' + (params.get('card') || DEFAULT_COLORS.card.replace('#', '')),
      accent: '#' + (params.get('accent') || DEFAULT_COLORS.accent.replace('#', '')),
      text: '#' + (params.get('text') || DEFAULT_COLORS.text.replace('#', '')),
    };
  }
  try {
    const saved = JSON.parse(localStorage.getItem('upcomingReleasesColors'));
    return saved ? { ...DEFAULT_COLORS, ...saved } : { ...DEFAULT_COLORS };
  } catch (e) {
    return { ...DEFAULT_COLORS };
  }
}

function saveColors(colors) {
  localStorage.setItem('upcomingReleasesColors', JSON.stringify(colors));
}

let currentColors = loadColors();
applyColors(currentColors);

gearBtn.addEventListener('click', () => {
  settingsPanel.classList.toggle('open');
});

[['bg', bgColorInput], ['card', cardColorInput], ['accent', accentColorInput], ['text', textColorInput]].forEach(([key, input]) => {
  input.addEventListener('input', () => {
    currentColors[key] = input.value;
    applyColors(currentColors);
    saveColors(currentColors);
  });
});

resetColorsBtn.addEventListener('click', () => {
  currentColors = { ...DEFAULT_COLORS };
  applyColors(currentColors);
  saveColors(currentColors);
});

document.getElementById('copyColorLink').addEventListener('click', async () => {
  const base = window.location.origin + window.location.pathname;
  const params = new URLSearchParams({
    bg: currentColors.bg.replace('#', ''),
    card: currentColors.card.replace('#', ''),
    accent: currentColors.accent.replace('#', ''),
    text: currentColors.text.replace('#', ''),
  });
  const link = `${base}?${params.toString()}`;
  try {
    await navigator.clipboard.writeText(link);
    alert('링크 복사됨 — Notion 임베드 URL을 이걸로 바꿔주세요');
  } catch (e) {
    prompt('복사 실패, 아래 링크를 직접 복사하세요', link);
  }
});

const WORKER_URL = 'https://music-search-proxy.jiyeonsung-jys.workers.dev';
const WORKER_SECRET = '여기에_Cloudflare에_넣은_WIDGET_SECRET_그대로_붙여넣기';

const statusEl = document.getElementById('status');
const releaseList = document.getElementById('releaseList');

const MONTH_ABBR = ['1월','2월','3월','4월','5월','6월','7월','8월','9월','10월','11월','12월'];

function dDayLabel(dateStr) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const target = new Date(dateStr + 'T00:00:00');
  const diff = Math.round((target - today) / 86400000);
  if (diff === 0) return 'D-DAY';
  if (diff > 0) return `D-${diff}`;
  return `D+${Math.abs(diff)}`;
}

async function loadUpcoming() {
  if (!WORKER_URL || WORKER_SECRET.includes('여기에')) {
    statusEl.textContent = 'widget 코드 상단의 WORKER_URL / WORKER_SECRET을 먼저 채워주세요';
    return;
  }
  statusEl.textContent = '불러오는 중...';
  try {
    const res = await fetch(`${WORKER_URL}?secret=${encodeURIComponent(WORKER_SECRET)}&upcoming=1`);
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || '불러오기 실패');

    const todayStr = new Date().toISOString().slice(0, 10);
    const upcoming = (data.events || []).filter(e => e.date >= todayStr);

    statusEl.textContent = upcoming.length ? '' : '';
    render(upcoming);
  } catch (err) {
    statusEl.textContent = '불러오기 실패: ' + err.message;
    render([]);
  }
}

function render(events) {
  releaseList.innerHTML = '';
  if (events.length === 0) {
    releaseList.innerHTML = '<div class="empty">예정된 발매가 없어요</div>';
    return;
  }

  events.forEach(e => {
    const [y, m, d] = e.date.split('-').map(Number);
    const card = document.createElement('div');
    card.className = 'release-card';
    card.innerHTML = `
      <div class="release-date">
        <span>${MONTH_ABBR[m - 1]}</span>
        <span class="day">${d}</span>
      </div>
      <div class="release-meta">
        <div class="release-title">${e.title}</div>
        <div class="release-artist">${e.artist}</div>
      </div>
      <div class="release-dday">${dDayLabel(e.date)}</div>
    `;
    releaseList.appendChild(card);
  });
}

loadUpcoming();
</script>
</body>
</html>
